  "content": "<div style=\"width: 480px; height: 350px; border: 1px solid #333; font-family: sans-serif; display: flex; background: #f4f4f4; position: relative; overflow: hidden;\">\n    <div style=\"width: 140px; padding: 10px; display: flex; flex-direction: column; align-items: center; justify-content: center; border-right: 1px dashed #ccc; background: #fff;\">\n        <img src=\"{{student_photo_url}}\" style=\"width: 100px; height: 100px; border-radius: 50%; object-fit: cover; border: 3px solid #0056b3; background: #eee;\">\n        <div style=\"margin-top: 20px; text-align: center;\">\n            <img src=\"{{qr_code_url}}\" style=\"width: 80px; height: 80px;\">\n        </div>\n    </div>\n    <div style=\"flex: 1; padding: 20px; position: relative;\">\n        <div style=\"text-align: right; margin-bottom: 10px;\">\n            <img src=\"{{school_logo_url}}\" style=\"height: 40px; object-fit: contain;\">\n        </div>\n        \n        <h2 style=\"margin: 0 0 5px 0; color: #0056b3; font-size: 1.4em; line-height: 1.2;\">{{staff_name}}</h2>\n        <span style=\"background: #e9ecef; color: #495057; padding: 4px 10px; font-size: 0.85em; border-radius: 4px; display: inline-block;\">{{designation}}</span>\n        \n        <div style=\"margin-top: 25px; font-size: 0.95em; color: #333;\">\n            <table style=\"width: 100%; border-collapse: collapse;\">\n                <tr><td style=\"padding: 3px 0; color: #555;\"><strong>ID:</strong></td><td style=\"padding: 3px 0; font-weight: 600;\">{{staff_no}}</td></tr>\n                <tr><td style=\"padding: 3px 0; color: #555;\"><strong>Dept:</strong></td><td style=\"padding: 3px 0; font-weight: 600;\">{{department}}</td></tr>\n                <tr><td style=\"padding: 3px 0; color: #555;\"><strong>Phone:</strong></td><td style=\"padding: 3px 0; font-weight: 600;\">{{phone}}</td></tr>\n                <tr><td style=\"padding: 3px 0; color: #555;\"><strong>DOJ:</strong></td><td style=\"padding: 3px 0; font-weight: 600;\">{{date_of_joining}}</td></tr>\n            </table>\n        </div>\n        \n        <div style=\"position: absolute; bottom: 15px; right: 20px; text-align: center;\">\n             <img src=\"{{student_photo_url}}\" style=\"height: 30px; display: block; margin: 0 auto;\">\n             <span style=\"font-size: 0.7em; color: #777;\">Authorized Signatory</span>\n        </div>\n    </div>\n</div>\n                ",
