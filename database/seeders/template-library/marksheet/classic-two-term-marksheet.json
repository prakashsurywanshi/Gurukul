{
  "title": "Classic Two-Term Marksheet",
  "category": "marksheet",
  "type": "achievement",
  "description": "Classic Two-Term Marksheet — demo-design document template.",
  "editor_type": "fabric",
  "card_width_mm": 210,
  "card_height_mm": 297,
  "content": "<!--\n    MARKSHEET TEMPLATE: \"Creane School Compact Portrait v3\"\n    - A4 Portrait Layout with compact styling for large data\n    - Optimized for multi-term consolidated marks tables\n-->\n\n<style>\n    @page {\n        size: A4 portrait;\n        margin: 5mm;\n    }\n    body {\n        font-family: Arial, sans-serif;\n        margin: 0;\n        padding: 0;\n        font-size: 8px;\n        color: #000;\n        -webkit-print-color-adjust: exact !important;\n        print-color-adjust: exact !important;\n    }\n    \n    .marksheet-wrapper {\n        padding: 5mm;\n        position: relative;\n        background-color: #fff;\n        max-width: 100%;\n    }\n\n    /* Watermark */\n    .marksheet-wrapper::after {\n        content: '';\n        position: absolute;\n        top: 50%; left: 50%;\n        width: 60%; height: 60%;\n        transform: translate(-50%, -50%);\n        background-image: url({{school_logo_url}});\n        background-repeat: no-repeat;\n        background-position: center;\n        background-size: contain;\n        opacity: 0.06;\n        z-index: -1;\n        pointer-events: none;\n    }\n\n    /* Header Banner - Compact */\n    .header-banner {\n        padding: 8px 10px;\n        margin: -5mm -5mm 8px -5mm;\n        background: linear-gradient(90deg, #003311, #006622);\n        color: white;\n        display: flex;\n        align-items: center;\n        gap: 15px;\n    }\n    .header-banner-logo { height: 60px; }\n    .header-banner-text { flex: 1; text-align: center; }\n    .header-banner-text h1 {\n        font-size: 24px;\n        font-weight: bold;\n        margin: 0;\n        letter-spacing: 1px;\n        text-transform: uppercase;\n    }\n    .header-banner-text p { margin: 2px 0; font-size: 9px; opacity: 0.9; }\n    \n    .report-title-section { text-align: center; margin: 5px 0; }\n    .report-title { font-weight: bold; font-size: 12px; margin: 0; color: #000; }\n    .academic-session { font-weight: bold; font-size: 10px; color: #003311; }\n    \n    /* Student Info - Compact 2-column */\n    .student-info-grid { display: flex; flex-wrap: wrap; width: 100%; margin-bottom: 8px; font-size: 9px; }\n    .info-col { width: 50%; }\n    .info-item { display: flex; padding: 1px 0; }\n    .info-label { width: 90px; font-weight: bold; }\n    .info-value { font-weight: bold; }\n    .info-value::before { content: \": \"; margin-right: 3px; }\n    \n    /* Marks Table - ULTRA COMPACT for large data */\n    .marks-table { \n        width: 100%; \n        border-collapse: collapse; \n        font-size: 7px; \n        margin-bottom: 6px; \n        border: 1px solid #333; \n    }\n    .marks-table th, .marks-table td { \n        border: 1px solid #333; \n        padding: 2px 1px; \n        text-align: center; \n        vertical-align: middle; \n        line-height: 1.1;\n    }\n    .marks-table .header-row-1, \n    .marks-table thead th { \n        background-color: #165402 !important; \n        color: white !important; \n        font-weight: bold; \n        font-size: 7px;\n    }\n    .marks-table .header-row-2 { background-color: #E8F5E9; font-weight: bold; }\n    .marks-table .subject-col, .marks-table .subject-name { \n        text-align: left; \n        padding-left: 3px; \n        font-weight: 600; \n        font-size: 7px;\n        white-space: nowrap;\n    }\n    .marks-table tfoot td, .marks-table .table-footer { \n        font-weight: bold; \n        background-color: #165402 !important; \n        color: white !important;\n    }\n\n    /* Footer Tables - Compact */\n    .footer-grid { display: flex; gap: 8px; width: 100%; margin-top: 6px; }\n    .footer-col { border: 1px solid #333; flex: 1; }\n    .footer-table, .cocurricular-table { width: 100%; border-collapse: collapse; font-size: 8px; }\n    .footer-table th, .footer-table td,\n    .cocurricular-table th, .cocurricular-table td { border: 1px solid #333; padding: 2px; }\n    .footer-table th, .cocurricular-table thead th { \n        background-color: #165402 !important; \n        color: white !important;\n        text-align: center; \n        font-size: 8px;\n    }\n\n    /* Attendance - Compact */\n    .attendance-table { width: 100%; font-size: 9px; margin-top: 6px; border-collapse: collapse; }\n    .attendance-table td { border: 1px solid #333; padding: 3px; font-weight: bold; text-align: center; }\n    .attendance-table .header-cell { background-color: #E0E0E0; }\n\n    .remarks-row { margin-top: 6px; font-size: 9px; font-weight: bold; }\n\n    /* Signatures - Compact */\n    .signature-section { display: flex; justify-content: space-between; margin-top: 25px; font-size: 9px; font-weight: bold; }\n    .signature-item { width: 30%; text-align: center; border-top: 1px solid #000; padding-top: 3px; }\n    \n    .instructions-section { margin-top: 8px; font-size: 8px; }\n    .instructions-title { font-weight: bold; }\n\n    /* PRINT MEDIA - Force all colors */\n    @media print {\n        * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }\n        .header-banner { background: #003311 !important; }\n        .marks-table thead th, .marks-table .header-row-1, .marks-table .table-footer,\n        .footer-table th, .cocurricular-table thead th { \n            background-color: #165402 !important; \n            color: white !important; \n        }\n        .marks-table th, .marks-table td { border: 1px solid #333 !important; }\n    }\n</style>\n\n<div class=\"marksheet-wrapper\">\n\n    <div class=\"header-banner\">\n        <img src=\"{{school_logo_url}}\" alt=\"School Logo\" class=\"header-banner-logo\">\n        <div class=\"header-banner-text\">\n            <h1>{{school_name}}</h1>\n            <p>Affiliated to {{school_affiliation}}</p>\n            <p style=\"font-size: 11px; font-weight: bold;\">{{school_address}}</p>\n        </div>\n    </div>\n\n    <div class=\"report-title-section\">\n        <h2 class=\"report-title\">REPORT CARD</h2>\n        <p class=\"academic-session\">ACADEMIC SESSION : {{academic_session}}</p>\n    </div>\n\n    <div class=\"student-info-grid\">\n        <div class=\"info-col\">\n            <div class=\"info-item\"><span class=\"info-label\">Admission No.</span> <span class=\"info-value\">{{admission_no}}</span></div>\n            <div class=\"info-item\"><span class=\"info-label\">Student's Name</span> <span class=\"info-value\">{{student_name}}</span></div>\n            <div class=\"info-item\"><span class=\"info-label\">Father's Name</span> <span class=\"info-value\">{{father_name}}</span></div>\n            <div class=\"info-item\"><span class=\"info-label\">Class (Section)</span> <span class=\"info-value\">{{class_section}}</span></div>\n            <div class=\"info-item\"><span class=\"info-label\">Exam Center</span> <span class=\"info-value\">{{school_name}}, {{school_address}}</span></div>\n        </div>\n        <div class=\"info-col\">\n            <div class=\"info-item\"><span class=\"info-label\">Roll No.</span> <span class=\"info-value\">{{roll_no}}</span></div>\n            <div class=\"info-item\"><span class=\"info-label\">Mother's Name</span> <span class=\"info-value\">{{mother_name}}</span></div>\n            <div class=\"info-item\"><span class=\"info-label\">School Name</span> <span class=\"info-value\">{{school_name}}</span></div>\n        </div>\n    </div>\n    \n    <!-- Consolidated Marks Table -->\n    {{consolidated_marks_table}}\n\n    <!-- Co-scholastic / Exam Observation -->\n    <div class=\"footer-grid\">\n        <div class=\"footer-col\">\n            {{cocurricular_table}}\n        </div>\n    </div>\n    \n    <!-- Attendance -->\n    \n    <!-- Remarks -->\n\n\n    <!-- Signatures -->\n    <div class=\"signature-section\">\n        <div class=\"signature-item\">Signature of Class Teacher</div>\n        <div class=\"signature-item\">\n            Signature of Principal\n        </div>\n        <div class=\"signature-item\">Controller of Examination</div>\n    </div>\n    \n    <!-- Instructions -->\n        <div style=\"margin-top: 5px;\">\n             {{grading_scale_inline}}\n        </div>\n</div>",
