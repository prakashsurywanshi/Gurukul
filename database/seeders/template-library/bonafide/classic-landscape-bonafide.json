  "content": "<div style=\"width: 100%; max-width: 950px; margin: auto; font-family: 'Times New Roman', serif; background: #fff; border: 1px solid #333; padding: 25px;\"><div style=\"display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #000; padding-bottom: 15px;\"><img src=\"{{school_logo_url}}\" style=\"height: 80px;\"><div style=\"text-align: center;\"><h1 style=\"margin: 0; font-size: 36px; font-weight: bold;\">{{school_name}}</h1><p style=\"margin: 5px 0 0 0; font-size: 14px;\">{{school_address}}</p></div><div style=\"width: 80px;\"></div></div><div style=\"text-align: center; margin: 30px 0;\"><h2 style=\"font-size: 28px; font-weight: bold; text-decoration: underline;\">BONAFIDE CERTIFICATE</h2></div><div style=\"font-size: 18px; line-height: 2.5;\"><p style=\"text-indent: 50px;\">This is to certify that Mr./Miss <strong>{{student_name}}</strong>, son/daughter of Mr. <strong>{{father_name}}</strong>, is a bonafide student of this school. He/She is studying in Class <strong>{{class_section}}</strong> during the academic year <strong>{{academic_session}}</strong>. His/Her date of birth as per our school record is <strong>{{dob}}</strong>. His/Her general conduct has been found to be satisfactory.</p><p style=\"text-indent: 50px;\">This certificate is issued for official purposes upon the request of the parent/guardian.</p></div><div style=\"display: flex; justify-content: space-between; align-items: flex-end; margin-top: 80px; font-size: 16px;\"><div style=\"text-align: left;\"><strong>Date:</strong> {{current_date}}</div><div style=\"text-align: right;\"><img src=\"{{student_photo_url}}\" style=\"height: 50px;\"><br><strong style=\"border-top: 1px solid #000; padding-top: 5px;\">Principal</strong></div></div></div>",
