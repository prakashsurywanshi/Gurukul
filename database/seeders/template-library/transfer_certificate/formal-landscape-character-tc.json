  "content": "<div style=\"width: 100%; max-width: 950px; margin: auto; font-family: 'Times New Roman', serif; background: #fff; border: 2px solid #000; padding: 25px;\"><div style=\"text-align: center; margin-bottom: 20px;\"><h1 style=\"margin: 0; font-size: 28px; font-weight: bold;\">{{school_name}}</h1><p style=\"margin: 5px 0;\">{{school_address}}</p><div style=\"display: flex; justify-content: space-between; align-items: flex-start; margin-top: 15px;\"><div style=\"text-align: left; font-size: 14px;\"><strong>Affiliation No:</strong> XXXXX</div><img src=\"{{school_logo_url}}\" style=\"height: 70px; margin: 0 20px;\"><div style=\"text-align: right; font-size: 14px;\"><strong>Date:</strong> {{current_date}}</div></div><h2 style=\"font-size: 20px; font-weight: bold; display: inline-block; border: 1px solid #000; padding: 5px 15px; margin: 15px 0;\">CHARACTER & TRANSFER CERTIFICATE</h2></div><div style=\"font-size: 16px; line-height: 2.2; text-align: justify;\"><p style=\"text-indent: 40px; margin: 0;\">This is to certify that Mr./Ms. <strong>{{student_name}}</strong>, son/daughter of Mr. <strong>{{father_name}}</strong> and Mrs. <strong>{{mother_name}}</strong>, was a bonafide student of this school. He/She has passed the <strong>{{class}}</strong> Examination and his/her character was <strong>GOOD</strong> during the period of his/her study. His/her date of birth according to our school register is <strong>{{dob}}</strong>.</p><p style=\"text-indent: 40px; margin-top: 10px;\">We wish him/her a successful career and a bright future in his/her life.</p></div><table style=\"width: 100%; margin-top: 70px; font-size: 14px; text-align: center;\"><tbody><tr><td style=\"padding-top: 50px; border-top: 1px solid #000;\">Written By</td><td style=\"padding-top: 50px; border-top: 1px solid #000;\">Checked By</td><td style=\"padding-top: 50px;\"><img src=\"{{student_photo_url}}\" style=\"height: 40px;\"><p style=\"margin:0; border-top: 1px solid #000; padding-top:2px;\">Headmaster / Principal</p></td></tr></tbody></table></div>",
