  "content": "<style>\n    .friendly-receipt-container {\n        max-width: 600px;\n        margin: 30px auto;\n        padding: 25px;\n        font-family: 'Lato', 'Segoe UI', sans-serif;\n        background-color: #fafffa;\n        border: 2px solid #65a30d;\n        border-radius: 10px;\n    }\n    .receipt-header {\n        display: flex; align-items: center; padding-bottom: 15px; border-bottom: 1px solid #dcfce7;\n    }\n    .receipt-header img { max-height: 50px; margin-right: 15px; }\n    .school-info h1 { font-size: 22px; margin: 0; color: #1a2e05; }\n    .receipt-title {\n        text-align: center; margin: 20px 0; font-size: 20px; font-weight: 700;\n        color: #3f6212;\n    }\n    .details-list { list-style: none; padding: 0; margin: 0 0 20px 0; font-size: 14px; }\n    .details-list li { display: flex; justify-content: space-between; padding: 5px 0; }\n    .details-list .label { font-weight: 600; color: #365314; }\n    .payment-summary-box {\n        background-color: #dcfce7;\n        border: 1px solid #bbf7d0;\n        border-radius: 8px;\n        padding: 20px;\n        text-align: center;\n        margin-bottom: 20px;\n    }\n    .payment-summary-box .label { font-size: 14px; color: #4d7c0f; }\n    .payment-summary-box .amount { font-size: 32px; font-weight: 700; color: #1a2e05; margin: 5px 0; }\n    .items-table { width: 100%; border-collapse: collapse; font-size: 13px; }\n    .items-table th, .items-table td { padding: 8px; text-align: left; border-bottom: 1px dotted #bbf7d0; }\n    .items-table th { color: #365314; }\n    .items-table .amount { text-align: right; }\n    .balance-due {\n        text-align: right; font-size: 16px; font-weight: bold; margin-top: 15px;\n        color: #b91c1c; /* Red for due amount */\n    }\n    .receipt-footer { text-align: center; margin-top: 25px; font-size: 12px; color: #65a30d; }\n</style>\n\n<div class=\"friendly-receipt-container\">\n    <div class=\"receipt-header\">\n        <img src=\"{{school_logo_url}}\" alt=\"Logo\">\n        <div class=\"school-info\"><h1>{{school_name}}</h1></div>\n    </div>\n\n    <h2 class=\"receipt-title\">Payment Acknowledgment</h2>\n\n    <ul class=\"details-list\">\n        <li><span class=\"label\">Student:</span> <span>{{student_name}} ({{admission_no}})</span></li>\n        <li><span class=\"label\">Receipt No:</span> <span>{{receipt_no}}</span></li>\n        <li><span class=\"label\">Date:</span> <span>{{payment_date}}</span></li>\n    </ul>\n\n    <div class=\"payment-summary-box\">\n        <div class=\"label\">AMOUNT PAID</div>\n        <div class=\"amount\">{{currency_symbol}}{{total_paid}}</div>\n        <div class=\"label\">via {{payment_mode}}</div>\n    </div>\n\n    <!-- This is where your dynamic fee breakdown table goes. It MUST have the class \"items-table\" -->\n    {{fee_group_breakdown_table}}\n\n    <div class=\"balance-due\">\n        Remaining Balance: {{currency_symbol}}{{student_overall_balance_due}}\n    </div>\n\n    <div class=\"receipt-footer\">\n        <p>Thank you for your timely payment!</p>\n    </div>\n</div>",
