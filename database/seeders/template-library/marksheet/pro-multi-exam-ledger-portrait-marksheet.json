  "content": "<div style=\"font-family: 'Courier New', Courier, monospace; padding: 20px; font-size: 12px; border: 1px solid #000;\">\n    <div style=\"text-align: center; margin-bottom: 20px;\">\n        <h1 style=\"margin: 0; font-size: 20px;\">{{school_name}}</h1>\n        <p style=\"margin: 0;\">=====================================================</p>\n        <h2 style=\"margin: 5px 0; font-size: 16px;\">STUDENT EVALUATION LEDGER</h2>\n        <p style=\"margin: 0;\">SESSION: {{academic_session}}</p>\n        <p style=\"margin: 0;\">=====================================================</p>\n    </div>\n\n    <div style=\"display: flex; border-bottom: 1px dashed #000; padding-bottom: 10px; margin-bottom: 20px;\">\n        <div style=\"flex: 1;\">\n            <strong>STUDENT :</strong> {{student_name}}<br>\n            <strong>ID/A.NO :</strong> {{admission_no}}<br>\n            <strong>FATHER  :</strong> {{father_name}}\n        </div>\n        <div style=\"flex: 1;\">\n            <strong>CLASS   :</strong> {{class_section}}<br>\n            <strong>ROLL NO :</strong> {{roll_no}}<br>\n            <strong>D.O.B   :</strong> {{dob}}\n        </div>\n    </div>\n\n    <div style=\"margin-bottom: 20px;\">\n        <h3 style=\"margin: 0 0 10px 0; font-size: 14px;\">--- SCHOLASTIC EVALUATION ---</h3>\n        <!-- This assumes the marks table is configured to show multiple exams horizontally -->\n        {{consolidated_marks_table}}\n    </div>\n\n    <div style=\"margin-bottom: 20px;\">\n        <h3 style=\"margin: 0 0 10px 0; font-size: 14px;\">--- CO-SCHOLASTIC EVALUATION ---</h3>\n        {{cocurricular_table}}\n    </div>\n\n    <div style=\"border-top: 1px dashed #000; padding-top: 10px; margin-bottom: 30px;\">\n        <strong>REMARKS:</strong> {{teacher_remark}}\n    </div>\n\n    <div style=\"border-top: 1px dashed #000; padding-top: 10px;\">\n        <strong>FINAL VERDICT:</strong> {{result_status}}\n    </div>\n\n    <div style=\"display: flex; justify-content: space-between; margin-top: 50px;\">\n        <span>______________________<br>CLASS TEACHER</span>\n        <span>______________________<br>PRINCIPAL</span>\n    </div>\n</div>",
