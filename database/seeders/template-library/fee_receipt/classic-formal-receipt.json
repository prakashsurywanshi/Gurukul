  "card_width_mm": 210,
  "card_height_mm": 297,
  "content": "<style>\n    .classic-receipt-container {\n        max-width: 700px;\n        margin: 30px auto;\n        padding: 10px;\n        font-family: 'Garamond', 'Times New Roman', serif;\n        background-color: #fff;\n        border: 1px solid #8c7a5b;\n    }\n    .receipt-inner-border {\n        border: 3px double #8c7a5b;\n        padding: 25px;\n    }\n    .receipt-header {\n        text-align: center;\n        margin-bottom: 20px;\n    }\n    .receipt-header img { max-height: 70px; margin-bottom: 10px; }\n    .receipt-header h1 { font-size: 30px; margin: 0; font-weight: bold; }\n    .receipt-header p { margin: 5px 0; font-size: 14px; }\n    .receipt-title {\n        text-align: center; margin: 20px 0; font-size: 22px; font-weight: bold;\n        text-decoration: underline;\n    }\n    .details-table { width: 100%; border-collapse: collapse; font-size: 14px; margin-bottom: 20px; }\n    .details-table td { padding: 6px; }\n    .details-table .label { font-weight: bold; width: 20%; }\n    .payment-summary { margin: 20px 0; font-size: 14px; }\n    .payment-summary p { margin: 10px 0; }\n    .items-table { width: 100%; border-collapse: collapse; font-size: 14px; margin-top: 10px; }\n    .items-table th, .items-table td { border: 1px solid #ccc; padding: 8px; text-align: left; }\n    .items-table th { background-color: #f7f6f4; }\n    .items-table .amount { text-align: right; }\n    .balance-due {\n        text-align: right; font-size: 18px; font-weight: bold; margin-top: 20px;\n        padding-top: 10px; border-top: 1px solid #8c7a5b;\n    }\n    .signature-section { margin-top: 80px; text-align: right; }\n    .signature-line {\n        border-top: 1px dotted #000;\n        width: 250px;\n        display: inline-block;\n        margin-bottom: 5px;\n    }\n</style>\n\n<div class=\"classic-receipt-container\">\n    <div class=\"receipt-inner-border\">\n        <div class=\"receipt-header\">\n            <img src=\"{{school_logo_url}}\" alt=\"Logo\">\n            <h1>{{school_name}}</h1>\n            <p>{{school_address}}</p>\n        </div>\n\n        <h2 class=\"receipt-title\">OFFICIAL RECEIPT OF PAYMENT</h2>\n\n        <table class=\"details-table\">\n            <tr>\n                <td class=\"label\">Receipt No:</td><td>{{receipt_no}}</td>\n                <td class=\"label\">Date:</td><td>{{payment_date}}</td>\n            </tr>\n            <tr>\n                <td class=\"label\">Student Name:</td><td colspan=\"3\">{{student_name}}</td>\n            </tr>\n            <tr>\n                <td class=\"label\">Admission No:</td><td>{{admission_no}}</td>\n                <td class=\"label\">Class:</td><td>{{class_section}}</td>\n            </tr>\n        </table>\n\n        <div class=\"payment-summary\">\n            <p><strong>Received with thanks the sum of:</strong> {{total_in_words}} Only.</p>\n            <p><strong>By:</strong> {{payment_mode}} | <strong>Total Amount:</strong> {{currency_symbol}}{{total_paid}}</p>\n        </div>\n\n        <!-- This is where your dynamic fee breakdown table goes. It MUST have the class \"items-table\" -->\n        {{fee_group_breakdown_table}}\n        \n        <div class=\"balance-due\">\n            Balance Due: {{currency_symbol}}{{student_overall_balance_due}}\n        </div>\n\n        <div class=\"signature-section\">\n            <div class=\"signature-line\"></div>\n            <p>Authorized Signatory</p>\n        </div>\n    </div>\n</div>",
