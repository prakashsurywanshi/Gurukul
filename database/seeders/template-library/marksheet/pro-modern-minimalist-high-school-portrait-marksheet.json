  "content": "<div style=\"font-family: 'Inter', 'Helvetica Neue', sans-serif; padding: 40px; background: #FAFAFA; color: #1a1a1a;\">\n    <div style=\"display: flex; justify-content: space-between; align-items: flex-end; border-bottom: 2px solid #1a1a1a; padding-bottom: 20px; margin-bottom: 30px;\">\n        <div>\n            <img src=\"{{school_logo_url}}\" style=\"max-height: 50px; margin-bottom: 10px;\">\n            <h1 style=\"margin: 0; font-size: 24px; font-weight: 800; letter-spacing: -0.5px;\">{{school_name}}</h1>\n            <p style=\"margin: 0; font-size: 12px; color: #666;\">{{school_address}}</p>\n        </div>\n        <div style=\"text-align: right;\">\n            <h2 style=\"margin: 0; font-size: 14px; text-transform: uppercase; color: #666; letter-spacing: 2px;\">Academic Transcript</h2>\n            <p style=\"margin: 5px 0 0 0; font-weight: 600; font-size: 16px;\">{{academic_session}}</p>\n        </div>\n    </div>\n\n    <div style=\"display: grid; grid-template-columns: 2fr 1fr; gap: 30px; margin-bottom: 40px;\">\n        <div style=\"background: #fff; padding: 20px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.02); border: 1px solid #eee;\">\n            <h3 style=\"margin: 0 0 15px 0; font-size: 12px; text-transform: uppercase; letter-spacing: 1px; color: #888;\">Student Profile</h3>\n            <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 15px; font-size: 14px;\">\n                <div><span style=\"color: #666; display: block; font-size: 11px; text-transform: uppercase;\">Name</span><strong>{{student_name}}</strong></div>\n                <div><span style=\"color: #666; display: block; font-size: 11px; text-transform: uppercase;\">Student ID</span><strong>{{admission_no}}</strong></div>\n                <div><span style=\"color: #666; display: block; font-size: 11px; text-transform: uppercase;\">Grade/Level</span><strong>{{class_section}}</strong></div>\n                <div><span style=\"color: #666; display: block; font-size: 11px; text-transform: uppercase;\">Date of Birth</span><strong>{{dob}}</strong></div>\n            </div>\n        </div>\n        <div style=\"background: #1a1a1a; color: #fff; padding: 20px; border-radius: 8px; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center;\">\n            <span style=\"font-size: 12px; text-transform: uppercase; letter-spacing: 1px; color: #aaa;\">Final Outcome</span>\n            <div style=\"font-size: 24px; font-weight: 800; margin-top: 5px;\">{{result_status}}</div>\n        </div>\n    </div>\n\n    <div style=\"margin-bottom: 30px;\">\n        <h3 style=\"margin: 0 0 15px 0; font-size: 12px; text-transform: uppercase; letter-spacing: 1px; color: #888;\">Academic Performance</h3>\n        <div style=\"background: #fff; padding: 10px; border-radius: 8px; border: 1px solid #eee;\">\n            {{consolidated_marks_table}}\n        </div>\n    </div>\n\n    <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 30px; margin-bottom: 50px;\">\n        <div>\n            <h3 style=\"margin: 0 0 15px 0; font-size: 12px; text-transform: uppercase; letter-spacing: 1px; color: #888;\">Co-Curricular</h3>\n            <div style=\"background: #fff; padding: 10px; border-radius: 8px; border: 1px solid #eee;\">\n                {{cocurricular_table}}\n            </div>\n        </div>\n        <div>\n            <h3 style=\"margin: 0 0 15px 0; font-size: 12px; text-transform: uppercase; letter-spacing: 1px; color: #888;\">Advisor's Note</h3>\n            <div style=\"background: #fff; padding: 20px; border-radius: 8px; border: 1px solid #eee; font-style: italic; font-size: 14px; min-height: 80px;\">\n                \"{{teacher_remark}}\"\n            </div>\n        </div>\n    </div>\n\n    <div style=\"display: flex; justify-content: space-between; align-items: flex-end; padding-top: 30px; border-top: 1px solid #eee;\">\n        <div>{{qr_code}}</div>\n        <div style=\"text-align: center; width: 200px;\">\n            <div style=\"border-bottom: 1px solid #1a1a1a; height: 30px; margin-bottom: 5px;\"></div>\n            <span style=\"font-size: 12px; text-transform: uppercase; letter-spacing: 1px; color: #888;\">Head of School</span>\n        </div>\n    </div>\n</div>",
