{
  "title": "Traditional Office Style School Slip",
  "category": "fee_receipt",
  "type": "completion",
  "description": "Traditional Office Style School Slip — demo-design document template.",
  "editor_type": "fabric",
  "card_width_mm": 297,
  "card_height_mm": 210,
  "content": "<style>\n    .traditional-receipt-container {\n        max-width: 800px;\n        margin: 30px auto;\n        padding: 20px;\n        font-family: Arial, Helvetica, sans-serif;\n        background-color: #fff;\n        border: 2px solid #000;\n    }\n    .master-table {\n        width: 100%;\n        border-collapse: collapse;\n        font-size: 13px;\n    }\n    .master-table th, .master-table td {\n        border: 1px solid #555;\n        padding: 8px;\n        vertical-align: top;\n    }\n    /* --- Header Styles --- */\n    .header-content {\n        display: flex;\n        justify-content: space-between;\n        align-items: center;\n    }\n    .header-content img { max-height: 60px; }\n    .school-info { text-align: center; }\n    .school-info h1 { font-size: 24px; margin: 0; }\n    .school-info p { font-size: 12px; margin: 4px 0 0 0; }\n    .receipt-title { font-size: 18px; font-weight: bold; text-align: center; }\n    /* --- Section & Label Styles --- */\n    .section-header td {\n        background-color: #f2f2f2;\n        font-weight: bold;\n        text-align: center;\n        font-size: 14px;\n    }\n    .label { font-weight: bold; }\n    .align-right { text-align: right; }\n    /* --- Nested Breakdown Table --- */\n    .breakdown-table { width: 100%; border-collapse: collapse; }\n    .breakdown-table th, .breakdown-table td { border: 1px solid #999; padding: 6px; }\n    .breakdown-table thead { background-color: #f8f8f8; font-weight: bold; }\n    /* --- Footer Styles --- */\n    .grand-total td { font-size: 16px; font-weight: bold; }\n    .signature-cell { height: 80px; }\n</style>\n\n<div class=\"traditional-receipt-container\">\n    <table class=\"master-table\">\n        <thead>\n            <!-- ==================== HEADER ==================== -->\n            <tr>\n                <th colspan=\"4\">\n                    <div class=\"header-content\">\n                        <img src=\"{{school_logo_url}}\" alt=\"Logo\">\n                        <div class=\"school-info\">\n                            <h1>{{school_name}}</h1>\n                            <p>{{school_address}}</p>\n                        </div>\n                        <div style=\"width: 60px;\"></div> <!-- Spacer -->\n                    </div>\n                </th>\n            </tr>\n            <tr>\n                <th colspan=\"4\" class=\"receipt-title\">FEE RECEIPT</th>\n            </tr>\n        </thead>\n        <tbody>\n            <!-- ==================== STUDENT DETAILS ==================== -->\n            <tr>\n                <td class=\"label\">Receipt No:</td>\n                <td>{{receipt_no}}</td>\n                <td class=\"label\">Payment Date:</td>\n                <td>{{payment_date}}</td>\n            </tr>\n            <tr>\n                <td class=\"label\">Student Name:</td>\n                <td>{{student_name}}</td>\n                <td class=\"label\">Class:</td>\n                <td>{{class_section}}</td>\n            </tr>\n            <tr>\n                <td class=\"label\">Admission No:</td>\n                <td>{{admission_no}}</td>\n                <td class=\"label\">Session:</td>\n                <td>{{academic_session}}</td>\n            </tr>\n            <!-- ==================== PAYMENT DETAILS ==================== -->\n            <tr class=\"section-header\">\n                <td colspan=\"4\">PAYMENT DETAILS</td>\n            </tr>\n            <tr>\n                <td colspan=\"4\">\n                    <!-- This is where your dynamic fee breakdown table goes. It MUST be a nested table. -->\n                    <!-- It should have the class \"breakdown-table\" -->\n                    {{fee_group_breakdown_table}}\n                </td>\n            </tr>\n            <!-- ==================== TOTALS ==================== -->\n            <tr>\n                <td class=\"label\">Payment Mode:</td>\n                <td colspan=\"3\">{{payment_mode}}</td>\n            </tr>\n             <tr>\n                <td class=\"label\">Amount in Words:</td>\n                <td colspan=\"3\">{{total_in_words}} Only</td>\n            </tr>\n            <tr class=\"grand-total\">\n                <td class=\"label align-right\" colspan=\"3\">Total Amount Paid:</td>\n                <td class=\"align-right\">{{currency_symbol}}{{total_paid}}</td>\n            </tr>\n             <tr class=\"grand-total\">\n                <td class=\"label align-right\" colspan=\"3\">Overall Balance Due:</td>\n                <td class=\"align-right\">{{currency_symbol}}{{student_overall_balance_due}}</td>\n            </tr>\n            <!-- ==================== SIGNATURE ==================== -->\n             <tr>\n                <td colspan=\"4\" class=\"signature-cell\">\n                    <span class=\"label\">Received By:</span>\n                </td>\n            </tr>\n        </tbody>\n    </table>\n</div>",
