  "content": "<style type=\"text/css\">\n    @page { size: A4 portrait; margin: 8mm; }\n    * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }\n\n    .pw-cert-sheet { width: 194mm; margin: 0 auto; border: 3px solid #b8860b; background: #fffdf7;\n        font-family: 'DejaVu Serif', Georgia, 'Times New Roman', Times, serif; color: #3a2f10; position: relative; }\n    .pw-cert-frame { border: 1px solid #d4af37; margin: 4mm; padding: 8mm 10mm; text-align: center; position: relative; }\n    .pw-cert-watermark { position: absolute; top: 50%; left: 50%; margin-left: -40mm; margin-top: -40mm;\n        width: 80mm; height: 80mm; opacity: 0.06; }\n    .pw-cert-watermark img { width: 80mm; height: auto; }\n\n    .pw-cert-logo img { width: 20mm; height: 20mm; object-fit: contain; }\n    .pw-cert-school { font-size: 15pt; font-weight: bold; text-transform: uppercase; letter-spacing: 1px; margin: 4px 0 0; color: #6b4e0e; }\n    .pw-cert-addr { font-size: 9pt; color: #7c6f4a; margin: 1px 0 0; }\n\n    .pw-cert-title { font-size: 30pt; font-weight: bold; letter-spacing: 4px; text-transform: uppercase; color: #b8860b; margin: 10mm 0 2mm; }\n    .pw-cert-sub { font-size: 11pt; letter-spacing: 3px; text-transform: uppercase; color: #7c6f4a; margin-bottom: 8mm; }\n\n    .pw-cert-present { font-size: 11pt; color: #5c4d1e; }\n    .pw-cert-name { font-size: 24pt; font-weight: bold; color: #3a2f10; margin: 4mm 0; border-bottom: 1px solid #d4af37; display: inline-block; padding: 0 12mm 2mm; }\n    .pw-cert-body { font-size: 12pt; line-height: 2; color: #3a2f10; margin: 4mm 8mm; }\n    .pw-cert-body b { color: #6b4e0e; }\n    .pw-cert-award { font-size: 12pt; font-weight: bold; color: #b8860b; margin: 6mm 0; }\n\n    .pw-cert-foot { width: 100%; border-collapse: collapse; margin-top: 14mm; font-size: 10pt; }\n    .pw-cert-foot td { width: 50%; text-align: center; padding-top: 2px; }\n    .pw-cert-foot .line { border-top: 1px solid #6b4e0e; padding-top: 4px; margin: 0 12mm; }\n</style>\n\n<div class=\"pw-cert-sheet\">\n    <div class=\"pw-cert-frame\">\n        <div class=\"pw-cert-watermark\"><img src=\"{{school_logo_url}}\" alt=\"\"></div>\n\n        <div class=\"pw-cert-logo\"><img src=\"{{school_logo_url}}\" alt=\"Logo\"></div>\n        <div class=\"pw-cert-school\">{{school_name}}</div>\n        <div class=\"pw-cert-addr\">{{school_address}}</div>\n\n        <div class=\"pw-cert-title\">Certificate of Merit</div>\n        <div class=\"pw-cert-sub\">Academic Excellence</div>\n\n        <div class=\"pw-cert-present\">This certificate is proudly presented to</div>\n        <div class=\"pw-cert-name\">{{student_name}}</div>\n\n        <div class=\"pw-cert-body\">\n            of Class <b>{{class_section}}</b>, for securing <b>[input:Position / Rank]</b> with\n            <b>[input:Percentage]%</b> in the <b>[input:Examination]</b>, session <b>{{academic_session}}</b>.\n        </div>\n\n        <div class=\"pw-cert-award\">★   [input:Award / Distinction]   ★</div>\n\n        <table class=\"pw-cert-foot\">\n            <tr>\n                <td><div class=\"line\">Date: {{current_date}}</div></td>\n                <td><div class=\"line\">Principal</div></td>\n            </tr>\n        </table>\n    </div>\n</div>",
