  "content": "<div style=\"font-family: 'Arial', sans-serif; display: flex; width: 100%; height: 95vh; background: #fff;\">\n    <!-- First Panel (Left Fold - Inside Left) -->\n    <div style=\"width: 33.33%; border-right: 1px dashed #ccc; padding: 20px; box-sizing: border-box; display: flex; flex-direction: column;\">\n        <div style=\"text-align: center; margin-bottom: 20px;\">\n            <img src=\"{{school_logo_url}}\" style=\"height: 50px;\">\n            <h2 style=\"margin: 10px 0 5px 0; font-size: 16px; color: #333;\">{{school_name}}</h2>\n            <div style=\"font-size: 11px; color: #666;\">{{school_address}}</div>\n        </div>\n        <div style=\"flex: 1;\">\n            <h3 style=\"font-size: 13px; border-bottom: 1px solid #333; padding-bottom: 5px;\">Student Profile</h3>\n            <table style=\"width: 100%; font-size: 12px; line-height: 2;\">\n                <tr><td><strong>Name:</strong></td><td>{{student_name}}</td></tr>\n                <tr><td><strong>Class:</strong></td><td>{{class_section}}</td></tr>\n                <tr><td><strong>Roll No:</strong></td><td>{{roll_no}}</td></tr>\n                <tr><td><strong>Adm No:</strong></td><td>{{admission_no}}</td></tr>\n                <tr><td><strong>D.O.B:</strong></td><td>{{dob}}</td></tr>\n                <tr><td><strong>Parent:</strong></td><td>{{father_name}}</td></tr>\n            </table>\n            \n            <h3 style=\"font-size: 13px; border-bottom: 1px solid #333; padding-bottom: 5px; margin-top: 20px;\">Co-Scholastic</h3>\n            {{cocurricular_table}}\n            \n            <div style=\"margin-top: 20px;\">{{qr_code}}</div>\n        </div>\n    </div>\n\n    <!-- Second Panel (Middle Fold - Center) -->\n    <div style=\"width: 33.33%; border-right: 1px dashed #ccc; padding: 20px; box-sizing: border-box;\">\n        <h3 style=\"text-align: center; font-size: 16px; margin: 0 0 20px 0; color: #2C3E50;\">ACADEMIC PERFORMANCE<br><span style=\"font-size: 12px; font-weight: normal;\">{{academic_session}}</span></h3>\n        <div style=\"font-size: 11px;\">\n            {{consolidated_marks_table}}\n        </div>\n    </div>\n\n    <!-- Third Panel (Right Fold - Inside Right) -->\n    <div style=\"width: 33.33%; padding: 20px; box-sizing: border-box; display: flex; flex-direction: column; justify-content: space-between;\">\n        <div>\n            <h3 style=\"font-size: 13px; border-bottom: 1px solid #333; padding-bottom: 5px;\">Grading Scale</h3>\n            <div style=\"font-size: 10px;\">{{grading_scale_table}}</div>\n            \n            <h3 style=\"font-size: 13px; border-bottom: 1px solid #333; padding-bottom: 5px; margin-top: 20px;\">Attendance</h3>\n            <div style=\"font-size: 11px;\">[component:attendance]</div>\n            \n            <h3 style=\"font-size: 13px; border-bottom: 1px solid #333; padding-bottom: 5px; margin-top: 20px;\">Teacher's Remark</h3>\n            <div style=\"font-size: 12px; font-style: italic;\">{{teacher_remark}}</div>\n        </div>\n        \n        <div style=\"text-align: center; border: 2px solid #2C3E50; padding: 10px; border-radius: 5px;\">\n            <div style=\"font-size: 12px; font-weight: bold;\">FINAL RESULT</div>\n            <div style=\"font-size: 16px; color: #E74C3C; font-weight: bold; margin-top: 5px;\">{{result_status}}</div>\n        </div>\n        \n        <div style=\"display: flex; justify-content: space-between; margin-top: 30px; font-size: 11px; font-weight: bold; text-align: center;\">\n            <div style=\"width: 45%; border-top: 1px solid #000; padding-top: 5px;\">Class Teacher</div>\n            <div style=\"width: 45%; border-top: 1px solid #000; padding-top: 5px;\">Principal</div>\n        </div>\n    </div>\n</div>",
