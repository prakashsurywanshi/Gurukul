  "content": "<div style=\"width: 320px; height: 480px; border: 1px solid #ddd; font-family: Arial, sans-serif; position: relative; background: #f9f9f9;\">\n    <div style=\"background: #0056b3; height: 100px; border-bottom-left-radius: 50% 20px; border-bottom-right-radius: 50% 20px;\"></div>\n    \n    <div style=\"text-align: center; margin-top: -60px;\">\n        <img src=\"{{student_photo_url}}\" style=\"width: 120px; height: 120px; border-radius: 50%; border: 4px solid white; object-fit: cover; background: #eee;\">\n    </div>\n    \n    <div style=\"text-align: center; margin-top: 15px;\">\n        <h2 style=\"margin: 0; color: #333;\">{{staff_name}}</h2>\n        <p style=\"margin: 5px 0; color: #666; font-weight: bold;\">{{designation}}</p>\n        <p style=\"margin: 0; color: #888; font-size: 0.9em;\">{{department}}</p>\n    </div>\n    \n    <div style=\"margin: 30px 20px; font-size: 0.9em; line-height: 1.6;\">\n        <div style=\"display: flex; justify-content: space-between; border-bottom: 1px solid #eee; padding: 5px 0;\">\n            <span style=\"color: #555;\">ID No:</span>\n            <span style=\"font-weight: bold; color: #333;\">{{staff_no}}</span>\n        </div>\n        <div style=\"display: flex; justify-content: space-between; border-bottom: 1px solid #eee; padding: 5px 0;\">\n            <span style=\"color: #555;\">Phone:</span>\n            <span style=\"font-weight: bold; color: #333;\">{{phone}}</span>\n        </div>\n        <div style=\"display: flex; justify-content: space-between; border-bottom: 1px solid #eee; padding: 5px 0;\">\n            <span style=\"color: #555;\">DOJ:</span>\n            <span style=\"font-weight: bold; color: #333;\">{{date_of_joining}}</span>\n        </div>\n         <div style=\"display: flex; justify-content: space-between; border-bottom: 1px solid #eee; padding: 5px 0;\">\n            <span style=\"color: #555;\">Blood Group:</span>\n            <span style=\"font-weight: bold; color: #333;\">{{blood_group}}</span>\n        </div>\n    </div>\n    \n    <div style=\"position: absolute; bottom: 20px; width: 100%; text-align: center;\">\n        <img src=\"{{school_logo_url}}\" style=\"height: 40px; opacity: 0.8;\">\n        <p style=\"margin: 5px 0 0; font-size: 0.8em; color: #999;\">{{school_name}}</p>\n    </div>\n</div>\n                ",
