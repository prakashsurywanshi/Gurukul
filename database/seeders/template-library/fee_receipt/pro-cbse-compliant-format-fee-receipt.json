  "content": "<div style=\"font-family: Times New Roman, Times, serif; max-width: 800px; margin: 0 auto; color: #000; padding: 20px;\">\n    <!-- Minimalist, strict tabular format preferred by traditional boards -->\n    <table style=\"width: 100%; text-align: center; margin-bottom: 20px;\">\n        <tbody><tr>\n            <td style=\"width: 15%; text-align: left;\"><img src=\"{{school_logo_url}}\" style=\"height: 80px;\"></td>\n            <td style=\"width: 70%;\">\n                <h1 style=\"margin: 0; font-size: 24px; text-transform: uppercase; font-weight: bold;\">{{MYschool_HUB}}</h1>\n                <h3 style=\"margin: 5px 0; font-size: 14px; font-weight: normal;\">Affiliated to C.B.S.E., New Delhi</h3>\n                <p style=\"margin: 0; font-size: 12px;\">{{school_address}} | Ph: {{school_phone}}</p>\n            </td>\n            <td style=\"width: 15%; text-align: right;\"><img src=\"{{qr_code_url}}\" style=\"height: 70px;\"></td>\n        </tr>\n    </tbody></table>\n\n    <div style=\"text-align: center; font-weight: bold; font-size: 16px; text-decoration: underline; margin-bottom: 20px;\">FEE RECEIPT</div>\n\n    <table style=\"width: 100%; margin-bottom: 20px; font-size: 14px;\">\n        <tbody><tr>\n            <td style=\"width: 15%;\"><strong>Receipt No:</strong></td><td style=\"width: 35%; border-bottom: 1px solid #000;\">{{receipt_no}}</td>\n            <td style=\"width: 15%; padding-left: 20px;\"><strong>Date:</strong></td><td style=\"width: 35%; border-bottom: 1px solid #000;\">{{payment_date}}</td>\n        </tr>\n        <tr>\n            <td style=\"padding-top: 10px;\"><strong>Student Name:</strong></td><td style=\"padding-top: 10px; border-bottom: 1px solid #000; font-weight: bold;\">{{student_name}}</td>\n            <td style=\"padding-left: 20px; padding-top: 10px;\"><strong>Adm. No:</strong></td><td style=\"padding-top: 10px; border-bottom: 1px solid #000;\">{{admission_no}}</td>\n        </tr>\n        <tr>\n            <td style=\"padding-top: 10px;\"><strong>Father's Name:</strong></td><td style=\"padding-top: 10px; border-bottom: 1px solid #000;\">{{father_name}}</td>\n            <td style=\"padding-left: 20px; padding-top: 10px;\"><strong>Class/Sec:</strong></td><td style=\"padding-top: 10px; border-bottom: 1px solid #000;\">{{class_name}} - {{section_name}}</td>\n        </tr>\n    </tbody></table>\n\n    <div style=\"border: 2px solid #000; padding: 15px; margin-bottom: 20px;\">\n        <div style=\"font-weight: bold; text-decoration: underline; margin-bottom: 10px;\">FEE PARTICULARS</div>\n        {{fee_group_breakdown_table}}\n    </div>\n\n    <table style=\"width: 100%; font-size: 14px; margin-bottom: 30px;\">\n        <tbody><tr>\n            <td style=\"width: 60%; vertical-align: top;\">\n                <strong>Amount Received in Words:</strong><br>\n                <div style=\"border-bottom: 1px solid #000; padding: 5px 0;\">{{currency_code}} {{total_in_words}} Only</div>\n                <div style=\"margin-top: 15px;\">\n                    <strong>Payment Mode:</strong> {{payment_mode}}<br>\n                    <strong>Instrument/Txn No:</strong> {{transaction_id}}\n                </div>\n            </td>\n            <td style=\"width: 40%; text-align: right; vertical-align: bottom;\">\n                <div style=\"font-size: 20px; font-weight: bold; margin-bottom: 30px;\">Total: {{currency_symbol}}{{total_paid}}</div>\n                <div style=\"font-weight: bold;\">Cashier / Accountant</div>\n            </td>\n        </tr>\n    </tbody></table>\n    \n    <div style=\"font-size: 10px; font-style: italic; border-top: 1px dashed #000; padding-top: 5px;\">\n        Note: Cheques are subject to realization. This is a computer generated receipt.\n    </div>\n</div>\n<style>\n    .custom-table-wrapper table, .custom-table-wrapper th, .custom-table-wrapper td { border: 1px solid #000 !important; color: #000 !important; }\n</style>",
