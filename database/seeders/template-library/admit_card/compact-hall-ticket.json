  "content": "<div style=\"font-family: Arial, Helvetica, sans-serif; color: #111; background: #fff; border: 1.5px solid #333; padding: 14px 18px; box-sizing: border-box;\">\n\n    <table style=\"width: 100%; border-bottom: 1.5px solid #333; padding-bottom: 6px; margin-bottom: 10px;\">\n        <tbody><tr>\n            <td style=\"width: 46px; vertical-align: middle;\"><img src=\"{{school_logo_url}}\" alt=\"\" style=\"width: 40px; height: auto;\"></td>\n            <td style=\"vertical-align: middle;\">\n                <div style=\"font-size: 15px; font-weight: bold; text-transform: uppercase;\">{{school_name}}</div>\n                <div style=\"font-size: 10px; color: #555;\">{{exam_name}} · {{exam_session}}</div>\n            </td>\n            <td style=\"width: 110px; text-align: right; vertical-align: middle;\">\n                <div style=\"font-size: 9px; text-transform: uppercase; letter-spacing: 1px; color: #666;\">Hall Ticket</div>\n                <div style=\"font-size: 14px; font-weight: bold; font-family: 'Courier New', monospace;\">{{hall_ticket_no}}</div>\n            </td>\n        </tr></tbody>\n    </table>\n\n    <table style=\"width: 100%; margin-bottom: 10px;\">\n        <tbody><tr>\n            <td style=\"vertical-align: top;\">\n                <table style=\"width: 100%; font-size: 12px; border-collapse: collapse;\">\n                    <tbody>\n                        <tr><td style=\"padding: 3px 0; width: 92px; color: #555;\">Name</td><td style=\"padding: 3px 0; font-weight: bold;\">: {{student_name}}</td></tr>\n                        <tr><td style=\"padding: 3px 0; color: #555;\">{{term_class}}</td><td style=\"padding: 3px 0;\">: {{class_name}} - {{section_name}}</td></tr>\n                        <tr><td style=\"padding: 3px 0; color: #555;\">Roll No.</td><td style=\"padding: 3px 0;\">: {{roll_no}}</td></tr>\n                        <tr><td style=\"padding: 3px 0; color: #555;\">Centre</td><td style=\"padding: 3px 0;\">: {{exam_centre}}</td></tr>\n                        <tr><td style=\"padding: 3px 0; color: #555;\">Report by</td><td style=\"padding: 3px 0;\">: {{reporting_time}}</td></tr>\n                    </tbody>\n                </table>\n            </td>\n            <!-- IF:show_photo -->\n            <td style=\"width: 84px; text-align: right; vertical-align: top;\">\n                <!-- IF:has_photo -->\n                <img src=\"{{student_photo_url}}\" alt=\"\" style=\"width: 74px; height: 92px; object-fit: cover; border: 1px solid #333;\">\n                <!-- ELSE -->\n                <div style=\"width: 74px; height: 92px; border: 1px solid #333; display: inline-block; line-height: 92px; text-align: center; font-size: 9px; color: #888;\">Photo</div>\n                <!-- ENDIF -->\n            </td>\n            <!-- ENDIF -->\n        </tr></tbody>\n    </table>\n\n    {{exam_schedule_table}}\n\n    <!-- IF:show_signature -->\n    <table style=\"width: 100%; margin-top: 26px;\">\n        <tbody><tr>\n            <td style=\"width: 50%; text-align: center; vertical-align: bottom;\">\n                <div style=\"border-top: 1px solid #333; margin: 0 20px 4px 20px;\"></div>\n                <div style=\"font-size: 11px;\">Candidate</div>\n            </td>\n            <td style=\"width: 50%; text-align: center; vertical-align: bottom;\">\n                <div style=\"border-top: 1px solid #333; margin: 0 20px 4px 20px;\"></div>\n                <div style=\"font-size: 11px; font-weight: bold;\">{{signatory_name}}</div>\n            </td>\n        </tr></tbody>\n    </table>\n    <!-- ENDIF -->\n</div>",
