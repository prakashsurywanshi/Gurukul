  "content": "<style type=\"text/css\">\n    @page { size: A4 portrait; margin: 8mm; }\n    * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }\n\n    .pw-ms-sheet { width: 194mm; margin: 0 auto; border: 1px solid #c7d2fe;\n        font-family: 'DejaVu Sans', Arial, Helvetica, sans-serif; color: #1e293b; background: #ffffff; }\n    .pw-ms-inner { padding: 5mm 6mm; }\n\n    /* Accent header band */\n    .pw-ms-band { background: #4f46e5; color: #ffffff; }\n    .pw-ms-band td { padding: 8px 10px; vertical-align: middle; }\n    .pw-ms-band h1 { margin: 0; font-size: 19pt; font-weight: bold; letter-spacing: .3px; }\n    .pw-ms-band .sub { margin: 1px 0 0; font-size: 9pt; color: #e0e7ff; }\n    .pw-ms-band .logo img { width: 16mm; height: 16mm; object-fit: contain; background:#fff; border-radius:4px; }\n    .pw-ms-band .doc { text-align: right; font-size: 9pt; color: #e0e7ff; }\n    .pw-ms-band .doc b { display:block; font-size: 12pt; color:#fff; }\n\n    .pw-ms-info { width: 100%; border-collapse: collapse; font-size: 9.5pt; margin: 7px 0 4px; }\n    .pw-ms-info td { padding: 3px 4px; }\n    .pw-ms-info .lbl { font-weight: bold; color: #475569; width: 15%; }\n    .pw-ms-info .val { border-bottom: 1px dotted #cbd5e1; width: 18%; }\n\n    /* KPI tiles */\n    .pw-ms-kpi { width: 100%; border-collapse: separate; border-spacing: 6px 0; margin: 6px 0; }\n    .pw-ms-kpi td { width: 33.33%; border: 1px solid #c7d2fe; padding: 8px; text-align: center; background: #eef2ff; }\n    .pw-ms-kpi .k { font-size: 8pt; color: #4f46e5; text-transform: uppercase; letter-spacing: 1px; font-weight: bold; }\n    .pw-ms-kpi .v { font-size: 16pt; font-weight: bold; color: #1e293b; margin-top: 2px; }\n\n    .pw-ms-section-title { font-size: 10pt; font-weight: bold; color: #4f46e5;\n        border-bottom: 2px solid #4f46e5; padding-bottom: 2px; margin: 9px 0 5px; }\n\n    .pw-ms-two { width: 100%; border-collapse: collapse; }\n    .pw-ms-two td { width: 50%; vertical-align: top; padding: 0 4px; }\n    .pw-ms-note { border: 1px solid #c7d2fe; background: #f8fafc; padding: 7px 9px; font-size: 9.5pt; min-height: 16mm; }\n    .pw-ms-note .k { font-weight: bold; color: #4f46e5; }\n\n    .pw-ms-sign { width: 100%; border-collapse: collapse; margin-top: 12mm; font-size: 9pt; }\n    .pw-ms-sign td { text-align: center; padding-top: 2px; border-top: 1px solid #475569; width: 33%; }\n    .pw-ms-foot { font-size: 8pt; color: #94a3b8; text-align: center; margin-top: 6px; }\n</style>\n\n<div class=\"pw-ms-sheet\">\n    <div class=\"pw-ms-inner\">\n\n        \n        <table class=\"pw-ms-band\" style=\"width:100%; border-collapse:collapse;\">\n            <tr>\n                <td class=\"logo\" style=\"width:20mm;\"><img src=\"{{school_logo_url}}\" alt=\"Logo\"></td>\n                <td>\n                    <h1>{{school_name}}</h1>\n                    <p class=\"sub\">{{school_address}}</p>\n                </td>\n                <td class=\"doc\" style=\"width:40mm;\">Performance Report<b>{{academic_session}}</b>{{class_section}}</td>\n            </tr>\n        </table>\n\n        \n        <table class=\"pw-ms-info\">\n            <tr>\n                <td class=\"lbl\">Name</td><td class=\"val\">{{student_name}}</td>\n                <td class=\"lbl\">Roll No.</td><td class=\"val\">{{roll_no}}</td>\n                <td class=\"lbl\">Adm No.</td><td class=\"val\">{{admission_no}}</td>\n            </tr>\n            <tr>\n                <td class=\"lbl\">Father</td><td class=\"val\">{{father_name}}</td>\n                <td class=\"lbl\">Mother</td><td class=\"val\">{{mother_name}}</td>\n                <td class=\"lbl\">DOB</td><td class=\"val\">{{dob}}</td>\n            </tr>\n        </table>\n\n        \n        <table class=\"pw-ms-kpi\">\n            <tr>\n                <td><div class=\"k\">Class Rank</div><div class=\"v\">{{rank}}</div></td>\n                <td><div class=\"k\">Attendance</div><div class=\"v\">{{attendance_percentage}}%</div></td>\n                <td><div class=\"k\">Result</div><div class=\"v\">{{result_status}}</div></td>\n            </tr>\n        </table>\n\n        \n        <div class=\"pw-ms-section-title\">Subject Performance</div>\n        [component:subject_bars]\n\n        \n        <div class=\"pw-ms-section-title\">Detailed Marks</div>\n        {{consolidated_marks_table}}\n\n        \n        <table class=\"pw-ms-two\">\n            <tr>\n                <td>\n                    <div class=\"pw-ms-section-title\">Co-Scholastic</div>\n                    {{cocurricular_table}}\n                </td>\n                <td>\n                    <div class=\"pw-ms-section-title\">Teacher's Note</div>\n                    <div class=\"pw-ms-note\"><span class=\"k\">Remarks:</span> {{teacher_remark}}</div>\n                </td>\n            </tr>\n        </table>\n\n        {{grading_scale_inline}}\n\n        <table class=\"pw-ms-sign\">\n            <tr>\n                <td>Class Teacher</td>\n                <td>Principal</td>\n                <td>Parent's Signature</td>\n            </tr>\n        </table>\n\n        <div class=\"pw-ms-foot\">Computer-generated performance report — {{school_name}}.</div>\n    </div>\n</div>",
