  "content": "<div style=\"font-family: 'Segoe UI', Arial, sans-serif; width: 100%; max-width: 800px; margin: 0 auto; color: #333;\">\n    <!-- Designed for A5 Landscape Printing (210 x 148 mm) -->\n    <table style=\"width: 100%; border-collapse: collapse; margin-bottom: 15px;\">\n        <tr>\n            <td style=\"width: 60%; vertical-align: top;\">\n                <div style=\"display: flex; align-items: center;\">\n                    <img src=\"{{school_logo_url}}\" alt=\"Logo\" style=\"height: 60px; margin-right: 15px;\">\n                    <div>\n                        <h2 style=\"margin: 0; font-size: 20px;\">{{school_name}}</h2>\n                        <div style=\"font-size: 11px; color: #666; margin-top: 3px;\">{{school_address}} | Tel: {{school_phone}}</div>\n                    </div>\n                </div>\n            </td>\n            <td style=\"width: 40%; text-align: right; vertical-align: top;\">\n                <h1 style=\"margin: 0; font-size: 24px; font-weight: 300; letter-spacing: 2px; color: #555;\">RECEIPT</h1>\n                <div style=\"margin-top: 8px; font-size: 13px;\">\n                    <strong>No:</strong> {{receipt_no}}<br>\n                    <strong>Date:</strong> {{payment_date}}\n                </div>\n            </td>\n        </tr>\n    </table>\n\n    <table style=\"width: 100%; border-collapse: collapse; margin-bottom: 20px; font-size: 13px;\">\n        <tr>\n            <td style=\"width: 50%; padding: 10px; border: 1px solid #ddd; background: #fafafa; vertical-align: top;\">\n                <div style=\"margin-bottom: 5px;\"><strong>Received From:</strong> {{student_name}}</div>\n                <div style=\"margin-bottom: 5px;\"><strong>Admission No:</strong> {{admission_no}}</div>\n                <div><strong>Class:</strong> {{class_name}} - {{section_name}}</div>\n            </td>\n            <td style=\"width: 50%; padding: 10px; border: 1px solid #ddd; background: #fafafa; vertical-align: top;\">\n                <div style=\"margin-bottom: 5px;\"><strong>Payment Method:</strong> {{payment_mode}}</div>\n                <div style=\"margin-bottom: 5px;\"><strong>Transaction Ref:</strong> {{transaction_id}}</div>\n                <div style=\"font-size: 18px; font-weight: bold; margin-top: 10px; text-align: center; color: #2196F3;\">\n                    {{currency_symbol}} {{total_paid}}\n                </div>\n            </td>\n        </tr>\n    </table>\n\n    <div style=\"min-height: 120px;\">\n        {{fee_group_breakdown_table}}\n    </div>\n\n    <table style=\"width: 100%; margin-top: 20px; font-size: 12px;\">\n        <tr>\n            <td style=\"width: 70%; vertical-align: bottom;\">\n                <strong>Amount in Words:</strong><br>\n                <span style=\"font-style: italic;\">{{currency_code}} {{total_in_words}} Only</span>\n            </td>\n            <td style=\"width: 30%; text-align: center; vertical-align: bottom;\">\n                <div style=\"border-bottom: 1px dotted #999; height: 30px; margin-bottom: 5px;\"></div>\n                Cashier Signature\n            </td>\n        </tr>\n    </table>\n</div>",
