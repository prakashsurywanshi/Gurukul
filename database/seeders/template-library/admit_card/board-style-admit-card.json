{
  "title": "Board Style Admit Card",
  "category": "admit_card",
  "type": "participation",
  "description": "Board Style Admit Card — demo-design document template.",
  "editor_type": "fabric",
  "card_width_mm": 210,
  "card_height_mm": 297,
  "content": "<div style=\"font-family: 'Times New Roman', Georgia, serif; color: #111; background: #fff; border: 3px double #1a1a1a; padding: 24px; box-sizing: border-box;\">\n\n    <table style=\"width: 100%; margin-bottom: 10px;\">\n        <tbody><tr>\n            <td style=\"width: 80px; vertical-align: middle;\"><img src=\"{{school_logo_url}}\" alt=\"\" style=\"width: 72px; height: auto;\"></td>\n            <td style=\"text-align: center; vertical-align: middle;\">\n                <div style=\"font-size: 24px; font-weight: bold; text-transform: uppercase; letter-spacing: 1px;\">{{school_name}}</div>\n                <div style=\"font-size: 12px; margin-top: 3px;\">{{school_address}}</div>\n                <div style=\"font-size: 12px;\">{{school_phone}}  |  {{school_email}}</div>\n            </td>\n            <td style=\"width: 80px; text-align: right; vertical-align: middle;\"><img src=\"{{admit_card_qr}}\" alt=\"\" style=\"width: 66px; height: 66px;\"></td>\n        </tr></tbody>\n    </table>\n\n    <div style=\"background: #1a1a1a; color: #fff; text-align: center; padding: 6px 0; font-size: 14px; font-weight: bold; text-transform: uppercase; letter-spacing: 3px; margin-bottom: 6px;\">Admit Card</div>\n    <div style=\"text-align: center; font-size: 13px; margin-bottom: 16px;\">{{exam_name}}  ·  Session {{exam_session}}</div>\n\n    <table style=\"width: 100%; margin-bottom: 14px;\">\n        <tbody><tr>\n            <td style=\"vertical-align: top;\">\n                <div style=\"border: 2px solid #1a1a1a; padding: 8px 12px; display: inline-block; margin-bottom: 12px;\">\n                    <div style=\"font-size: 10px; text-transform: uppercase; letter-spacing: 1px; color: #555;\">Hall Ticket No.</div>\n                    <div style=\"font-size: 22px; font-weight: bold; font-family: 'Courier New', monospace; letter-spacing: 2px;\">{{hall_ticket_no}}</div>\n                </div>\n                <table style=\"width: 100%; border-collapse: collapse; font-size: 14px;\">\n                    <tbody>\n                        <tr><td style=\"padding: 5px 0; width: 150px; color: #444;\">Candidate Name</td><td style=\"padding: 5px 0; font-weight: bold;\">: {{student_name}}</td></tr>\n                        <tr><td style=\"padding: 5px 0; color: #444;\">Father's Name</td><td style=\"padding: 5px 0;\">: {{father_name}}</td></tr>\n                        <tr><td style=\"padding: 5px 0; color: #444;\">Mother's Name</td><td style=\"padding: 5px 0;\">: {{mother_name}}</td></tr>\n                        <tr><td style=\"padding: 5px 0; color: #444;\">{{term_class}} / {{term_section}}</td><td style=\"padding: 5px 0;\">: {{class_name}} - {{section_name}}</td></tr>\n                        <tr><td style=\"padding: 5px 0; color: #444;\">Date of Birth</td><td style=\"padding: 5px 0;\">: {{dob}}</td></tr>\n                        <tr><td style=\"padding: 5px 0; color: #444;\">Examination Centre</td><td style=\"padding: 5px 0;\">: {{exam_centre}}</td></tr>\n                        <tr><td style=\"padding: 5px 0; color: #444;\">Reporting Time</td><td style=\"padding: 5px 0;\">: {{reporting_time}}</td></tr>\n                    </tbody>\n                </table>\n            </td>\n            <!-- IF:show_photo -->\n            <td style=\"width: 130px; vertical-align: top; text-align: right;\">\n                <!-- IF:has_photo -->\n                <img src=\"{{student_photo_url}}\" alt=\"\" style=\"width: 118px; height: 148px; object-fit: cover; border: 1px solid #1a1a1a; padding: 2px;\">\n                <!-- ELSE -->\n                <div style=\"width: 118px; height: 148px; border: 1px solid #1a1a1a; display: inline-block; text-align: center; line-height: 148px; font-size: 11px; color: #888;\">Affix Photo</div>\n                <!-- ENDIF -->\n                <div style=\"font-size: 10px; color: #666; margin-top: 4px;\">Attested photograph</div>\n            </td>\n            <!-- ENDIF -->\n        </tr></tbody>\n    </table>\n\n    <div style=\"font-size: 13px; font-weight: bold; text-transform: uppercase; letter-spacing: 1px; border-bottom: 1px solid #1a1a1a; padding-bottom: 4px; margin-bottom: 8px;\">Examination Schedule</div>\n    {{exam_schedule_table}}\n\n    <div style=\"border: 1px solid #999; padding: 10px 12px; margin-top: 16px; font-size: 11px; line-height: 1.6;\">\n        <div style=\"font-weight: bold; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 1px;\">Instructions to Candidates</div>\n        {{instructions}}\n    </div>\n\n    <!-- IF:show_signature -->\n    <table style=\"width: 100%; margin-top: 40px;\">\n        <tbody><tr>\n            <td style=\"width: 33%; text-align: center; vertical-align: bottom;\">\n                <div style=\"border-top: 1px solid #1a1a1a; margin: 0 12px 5px 12px;\"></div>\n                <div style=\"font-size: 12px;\">Candidate's Signature</div>\n            </td>\n            <td style=\"width: 33%; text-align: center; vertical-align: bottom;\">\n                <div style=\"border-top: 1px solid #1a1a1a; margin: 0 12px 5px 12px;\"></div>\n                <div style=\"font-size: 12px;\">Invigilator</div>\n            </td>\n            <td style=\"width: 33%; text-align: center; vertical-align: bottom;\">\n                <div style=\"border-top: 1px solid #1a1a1a; margin: 0 12px 5px 12px;\"></div>\n                <div style=\"font-size: 12px; font-weight: bold;\">{{signatory_name}}</div>\n            </td>\n        </tr></tbody>\n    </table>\n    <!-- ENDIF -->\n</div>",
