  "content": "<div style=\"font-family: 'Times New Roman', Times, serif; padding: 40px; background: #fff; border: 1px solid #ddd;\">\n    <div style=\"text-align: center; border-bottom: 1px solid #000; padding-bottom: 20px; margin-bottom: 30px;\">\n        <img src=\"{{school_logo_url}}\" style=\"height: 60px; margin-bottom: 10px;\">\n        <h1 style=\"margin: 0; font-size: 24px; font-weight: normal; letter-spacing: 1px;\">{{school_name}}</h1>\n        <p style=\"margin: 5px 0 0 0; font-size: 14px;\">STATEMENT OF RESULTS</p>\n    </div>\n\n    <div style=\"display: flex; justify-content: space-between; margin-bottom: 30px; font-size: 12px; line-height: 1.5;\">\n        <table style=\"width: 45%;\">\n            <tr><td style=\"width: 40%;\">CANDIDATE NAME:</td><td><strong>{{student_name}}</strong></td></tr>\n            <tr><td>DATE OF BIRTH:</td><td>{{dob}}</td></tr>\n            <tr><td>CENTRE NUMBER:</td><td>IN123</td></tr>\n        </table>\n        <table style=\"width: 45%;\">\n            <tr><td style=\"width: 40%;\">CANDIDATE NUMBER:</td><td>{{admission_no}}</td></tr>\n            <tr><td>SYLLABUS / LEVEL:</td><td>{{class_section}}</td></tr>\n            <tr><td>SERIES:</td><td>{{academic_session}}</td></tr>\n        </table>\n    </div>\n\n    <div style=\"min-height: 400px; margin-bottom: 30px;\">\n        <p style=\"font-size: 12px; margin-bottom: 10px;\">Syllabuses taken and grades achieved:</p>\n        {{consolidated_marks_table}}\n        \n        <p style=\"font-size: 12px; margin-top: 30px;\">Extra-Curricular Assessments:</p>\n        {{cocurricular_table}}\n    </div>\n\n    <div style=\"display: flex; justify-content: space-between; align-items: flex-end; margin-top: 50px;\">\n        <div style=\"width: 60%;\">\n            <p style=\"font-size: 11px; color: #555; text-align: justify;\">\n                <strong>Explanatory Notes:</strong><br>\n                This statement of results is not a certificate. CIE reserves the right to amend the information given on this statement, which will be confirmed by the issue of certificates. Grades A*(a*) to G(g) indicate the standard reached, A*(a*) being the highest and G(g) the lowest.\n            </p>\n            <p style=\"font-size: 11px; margin-top: 10px;\">\n                <strong>Result:</strong> {{result_status}}\n            </p>\n        </div>\n        <div style=\"width: 30%; text-align: center;\">\n            <div style=\"border-bottom: 1px solid #000; height: 30px; margin-bottom: 5px;\"></div>\n            <p style=\"margin: 0; font-size: 12px;\">Vice-Chancellor</p>\n        </div>\n    </div>\n</div>",
