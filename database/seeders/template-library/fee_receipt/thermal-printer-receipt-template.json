  "description": "Thermal Printer Receipt Template — demo-design document template.",
  "editor_type": "fabric",
  "card_width_mm": 93.13,
  "card_height_mm": 182.62,
  "content": "<style>\n    /* ---- Thermal Printer Receipt Styles ---- */\n    .thermal-receipt {\n        max-width: 320px; /* Common width for 80mm thermal paper */\n        margin: 30px auto;\n        padding: 15px;\n        font-family: 'Courier New', monospace; /* The classic receipt font */\n        font-size: 13px;\n        line-height: 1.6;\n        color: #000;\n        background: #fff;\n        border: 1px dashed #888;\n    }\n    .receipt-header {\n        text-align: center;\n        margin-bottom: 15px;\n    }\n    .receipt-header img {\n        max-height: 50px;\n        margin-bottom: 10px;\n    }\n    .receipt-header h1 {\n        font-size: 18px;\n        font-weight: bold;\n        margin: 0;\n        text-transform: uppercase;\n    }\n    .receipt-header p {\n        margin: 2px 0;\n        font-size: 12px;\n    }\n    .receipt-title {\n        text-align: center;\n        font-size: 16px;\n        font-weight: bold;\n        margin: 15px 0;\n        text-transform: uppercase;\n    }\n    .separator {\n        border-top: 1px dashed #000;\n        margin: 10px 0;\n    }\n    .details-row {\n        display: flex;\n        justify-content: space-between;\n        margin-bottom: 2px;\n    }\n    .details-row .label {\n        font-weight: bold;\n    }\n    .items-table {\n        width: 100%;\n        border-collapse: collapse;\n    }\n    .items-table thead th {\n        border-bottom: 1px dashed #000;\n        text-align: left;\n        padding-bottom: 5px;\n    }\n    .items-table .amount-col {\n        text-align: right;\n    }\n    .items-table tbody td, .items-table tfoot td {\n        padding: 5px 0;\n    }\n    .items-table tfoot .total-row td {\n        border-top: 1px dashed #000;\n        font-weight: bold;\n    }\n    .total-balance {\n        margin-top: 15px;\n        padding-top: 10px;\n        border-top: 2px solid #000;\n        text-align: right;\n        font-size: 16px;\n        font-weight: bold;\n    }\n    .receipt-footer {\n        text-align: center;\n        margin-top: 20px;\n    }\n    .receipt-footer img {\n        max-height: 60px;\n        margin: 10px 0;\n    }\n</style>\n\n<div class=\"thermal-receipt\">\n\n    <div class=\"receipt-header\">\n        {{school_logo_url}}<img src=\"{{school_logo_url}}\" alt=\"Logo\" style=\"width: 50%;\">\n        <h1>{{school_name}}</h1>\n        <p>{{school_address}}</p>\n    </div>\n\n    <div class=\"separator\"></div>\n    <h2 class=\"receipt-title\">FEE RECEIPT</h2>\n    <div class=\"separator\"></div>\n\n    <div class=\"details-row\">\n        <span class=\"label\">Receipt No:</span>\n        <span>{{receipt_no}}</span>\n    </div>\n    <div class=\"details-row\">\n        <span class=\"label\">Date:</span>\n        <span>{{payment_date}}</span>\n    </div>\n    <div class=\"details-row\">\n        <span class=\"label\">Adm No:</span>\n        <span>{{admission_no}}</span>\n    </div>\n    <div class=\"details-row\">\n        <span class=\"label\">Name:</span>\n        <span>{{student_name}}</span>\n    </div>\n    <div class=\"details-row\">\n        <span class=\"label\">Class:</span>\n        <span>{{class_section}}</span>\n    </div>\n    <div class=\"details-row\">\n        <span class=\"label\">Session:</span>\n        <span>{{academic_session}}</span>\n    </div>\n    <div class=\"details-row\">\n        <span class=\"label\">Pay Mode:</span>\n        <span>{{payment_mode}}</span></div><div class=\"details-row\"><span><span style=\"color: rgb(33, 37, 41); font-family: Arial, sans-serif; font-size: 16px;\">{{fee_group_breakdown_table}}</span></span>\n    </div>\n\n    <div class=\"separator\"></div>\n\n    <!-- \n        IMPORTANT: Your {{fee_group_breakdown_table}} needs to be generated\n        with this HTML structure to render correctly.\n    -->\n    <table class=\"items-table\">\n        <thead>\n            <tr>\n        </tr></thead>\n        <tbody>\n            <!-- EXAMPLE ROW: Repeat this for each fee group -->\n        </tbody>\n        <tfoot>\n            <tr class=\"total-row\">\n                <td>TOTAL PAID:</td>\n                <td colspan=\"2\" class=\"amount-col\">{{currency_symbol}}{{total_paid}}</td>\n            </tr>\n        </tfoot>\n    </table>\n    \n    <div class=\"details-row\" style=\"margin-top: 10px;\">\n        <span class=\"label\">In Words:</span>\n        <span>{{total_in_words}} Only</span>\n    </div>\n\n    <div class=\"total-balance\">\n        Overall Due: {{currency_symbol}}{{student_overall_balance_due}}\n    </div>\n\n    <div class=\"receipt-footer\">\n        <p>This is a computer generated receipt.</p>\n        <img src=\"{{qr_code_url}}\" alt=\"QR Code\">\n        <p><strong>PARENT COPY</strong></p>\n    </div>\n\n</div>",
