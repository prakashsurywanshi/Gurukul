  "content": "<div style=\"font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; padding: 10px; border: 5px solid #2c3e50; border-radius: 10px;\">\n            <div style=\"display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid #2c3e50; padding-bottom: 15px;\">\n                 <div style=\"width: 80px;\">{{qr_code}}</div>\n                 <div style=\"text-align: center; flex: 1;\">\n                    <h1 style=\"margin: 0; color: #2c3e50; font-size: 24px;\">{{school_name}}</h1>\n                    <p style=\"margin: 5px 0;\">{{school_address}}</p>\n                </div>\n                <div style=\"width: 80px;\">\n                    <img src=\"{{school_logo_url}}\" style=\"width: 100%; max-height: 80px; object-fit: contain;\">\n                </div>\n            </div>\n            <div style=\"text-align: center; margin-top: 10px;\">\n                <h3 style=\"margin: 0; background: #2c3e50; color: #fff; display: inline-block; padding: 5px 20px; border-radius: 20px;\">CONSOLIDATED MARKSHEET</h3>\n                <p style=\"margin-top: 5px; font-weight: bold;\">{{academic_session}}</p>\n            </div>\n            <div style=\"display: flex; margin: 20px 0; border-bottom: 1px dotted #ccc; padding-bottom: 15px;\">\n                <div style=\"flex: 1; font-size: 14px; line-height: 1.6;\">\n                    <strong>Name:</strong> {{student_name}}<br>\n                    <strong>Father's Name:</strong> {{father_name}}<br>\n                    <strong>Adm No:</strong> {{admission_no}} | <strong>Roll No:</strong> {{roll_no}}<br>\n                    <strong>D.O.B:</strong> {{dob}}\n                </div>\n                <div style=\"width: 90px; height: 90px; border: 2px solid #2c3e50; padding: 2px;\">\n                    <img src=\"{{student_photo_url}}\" style=\"width: 100%; height: 100%; object-fit: cover;\">\n                </div>\n            </div>\n            {{consolidated_marks_table}}\n            <div style=\"margin-top: 15px;\">{{cocurricular_table}}</div>\n            <div style=\"display: flex; margin-top: 20px; gap: 15px;\">\n                <div style=\"flex: 1;\">[component:health_status]</div>\n                <div style=\"flex: 1;\">[component:personal_qualities]</div>\n            </div>\n            <div style=\"display: flex; margin-top: 15px; gap: 15px;\">\n                <div style=\"flex: 1;\">[component:attendance]</div>\n                <div style=\"flex: 1;\">[component:abbreviations]</div>\n            </div>\n            <div style=\"margin-top: 20px;\">{{grading_scale_table}}</div>\n            <div style=\"margin-top: 20px; font-weight: bold; font-size: 1.1em;\">Final Result: {{result_status}}</div>\n            <div style=\"margin-top: 60px; display: flex; justify-content: space-around; font-weight: bold;\">\n                <div style=\"width: 150px; text-align: center;\"><hr style=\"border: 0; border-top: 1px solid #000;\">Class Teacher</div>\n                <div style=\"width: 150px; text-align: center;\"><hr style=\"border: 0; border-top: 1px solid #000;\">Principal</div>\n            </div>\n        </div>",
