  "content": "<div style=\"font-family: 'Courier New', Courier, monospace; width: 220px; margin: 0 auto; color: #000; font-size: 10px; line-height: 1.3; padding: 5px;\">\n    <!-- 58mm Thermal Printer Width (approx 220px) - Narrower than 80mm -->\n    \n    <div style=\"text-align: center; margin-bottom: 5px;\">\n        <div style=\"font-weight: bold; font-size: 12px; text-transform: uppercase;\">{{school_name}}</div>\n        <div style=\"font-size: 9px;\">{{school_phone}}</div>\n    </div>\n    \n    <div style=\"border-bottom: 1px dashed #000; margin-bottom: 5px; padding-bottom: 5px; text-align: center;\">\n        FEE RECEIPT\n    </div>\n    \n    <div style=\"border-bottom: 1px dashed #000; margin-bottom: 5px; padding-bottom: 5px;\">\n        Dt:{{payment_date}}<br>\n        R#:{{receipt_no}}<br>\n        St:{{student_name}}<br>\n        Ad:{{admission_no}} / Cl:{{class_name}}-{{section_name}}<br>\n        MO:{{payment_mode}}\n    </div>\n    \n    <div style=\"margin-bottom: 10px;\">\n        {{fee_group_breakdown_table}}\n    </div>\n    \n    <div style=\"border-top: 1px dotted #000; padding-top: 5px; font-weight: bold; font-size: 12px;\">\n        TOTAL PAID: {{currency_symbol}}{{total_paid}}\n    </div>\n\n    <div style=\"text-align: center; font-size: 9px; margin-top: 10px;\">\n        *** Thank You ***<br>\n        .\n    </div>\n</div>\n<style>\n    /* Aggressive compression for 58mm POS */\n    table { width: 100% !important; margin: 0 !important; }\n    table th, table td { font-size: 9px !important; padding: 1px !important; border: none !important; }\n    h4 { font-size: 10px !important; margin: 2px 0 !important; text-decoration: underline; }\n    table tfoot tr { border-top: 1px dashed #000 !important; }\n</style>",
