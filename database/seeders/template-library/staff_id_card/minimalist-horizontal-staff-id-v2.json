  "content": "<div style=\"width: 480px; height: 300px; border: 1px solid #ccc; font-family: Helvetica, sans-serif; display: flex; background: white;\">\n    <div style=\"width: 150px; background: #333; display: flex; align-items: center; justify-content: center; flex-direction: column; color: white;\">\n        <img src=\"{{student_photo_url}}\" style=\"width: 100px; height: 100px; border-radius: 5px; object-fit: cover; border: 2px solid white; margin-bottom: 10px;\">\n        <div style=\"font-size: 0.8em; text-align: center; padding: 0 10px;\">\n             {{school_name}}\n        </div>\n    </div>\n    <div style=\"flex: 1; padding: 20px;\">\n        <div style=\"border-bottom: 2px solid #333; padding-bottom: 10px; margin-bottom: 15px;\">\n            <h2 style=\"margin: 0; text-transform: uppercase; font-size: 1.4em;\">{{staff_name}}</h2>\n            <span style=\"background: #333; color: white; padding: 2px 8px; font-size: 0.8em; border-radius: 3px;\">{{designation}}</span>\n        </div>\n        \n        <table style=\"width: 100%; font-size: 0.9em; border-collapse: collapse;\">\n            <tr>\n                <td style=\"padding: 4px 0; color: #666;\">ID Number:</td>\n                <td style=\"padding: 4px 0; font-weight: bold;\">{{staff_no}}</td>\n            </tr>\n            <tr>\n                <td style=\"padding: 4px 0; color: #666;\">Department:</td>\n                <td style=\"padding: 4px 0; font-weight: bold;\">{{department}}</td>\n            </tr>\n            <tr>\n                <td style=\"padding: 4px 0; color: #666;\">Contact:</td>\n                <td style=\"padding: 4px 0; font-weight: bold;\">{{phone}}</td>\n            </tr>\n            <tr>\n                <td style=\"padding: 4px 0; color: #666;\">Joined:</td>\n                <td style=\"padding: 4px 0; font-weight: bold;\">{{date_of_joining}}</td>\n            </tr>\n        </table>\n        \n        <div style=\"margin-top: 20px; text-align: right;\">\n             <img src=\"{{student_photo_url}}\" style=\"height: 30px;\">\n             <p style=\"margin:0; font-size: 0.7em; color: #999;\">Authorized Signature</p>\n        </div>\n    </div>\n</div>\n                ",
