  "content": "<div style=\"width:204px;height:325px;border:1px solid #ddd;font-family:Arial,Helvetica,sans-serif;position:relative;background:#fff;overflow:hidden;border-radius:8px;box-shadow:0 2px 8px rgba(0,0,0,0.1);\">\n    <!-- Header Banner -->\n    <div style=\"background:linear-gradient(135deg,#1a237e 0%,#283593 100%);padding:8px 10px;text-align:center;\">\n        <table style=\"width:100%;border-collapse:collapse;\">\n            <tr>\n                <td style=\"width:28px;vertical-align:middle;\"><img src=\"{{school_logo_url}}\" style=\"width:24px;height:24px;border-radius:3px;object-fit:contain;background:#fff;\" alt=\"\"></td>\n                <td style=\"vertical-align:middle;text-align:center;padding-left:4px;\">\n                    <div style=\"color:#fff;font-size:9px;font-weight:bold;text-transform:uppercase;letter-spacing:0.5px;line-height:1.2;\">{{school_name}}</div>\n                    <div style=\"color:rgba(255,255,255,0.7);font-size:6px;margin-top:1px;\">STAFF IDENTITY CARD</div>\n                </td>\n            </tr>\n        </table>\n    </div>\n\n    <!-- Photo -->\n    <div style=\"text-align:center;margin-top:10px;\">\n        <img src=\"{{student_photo_url}}\" style=\"width:70px;height:70px;border-radius:50%;border:3px solid #1a237e;object-fit:cover;background:#e8eaf6;\">\n    </div>\n\n    <!-- Name & Title -->\n    <div style=\"text-align:center;margin-top:6px;padding:0 8px;\">\n        <div style=\"font-size:12px;font-weight:bold;color:#1a237e;line-height:1.2;text-transform:uppercase;\">{{staff_name}}</div>\n        <div style=\"font-size:8px;color:#fff;background:#ff6f00;display:inline-block;padding:2px 8px;border-radius:10px;margin-top:3px;font-weight:bold;\">{{designation}}</div>\n    </div>\n\n    <!-- Details -->\n    <div style=\"margin:8px 10px 0;font-size:8px;color:#333;\">\n        <table style=\"width:100%;border-collapse:collapse;\">\n            <tr><td style=\"padding:2px 0;color:#666;width:55px;\">ID No:</td><td style=\"padding:2px 0;font-weight:bold;\">{{staff_no}}</td></tr>\n            <tr><td style=\"padding:2px 0;color:#666;\">Dept:</td><td style=\"padding:2px 0;font-weight:bold;\">{{department}}</td></tr>\n            <tr><td style=\"padding:2px 0;color:#666;\">Phone:</td><td style=\"padding:2px 0;font-weight:bold;\">{{phone}}</td></tr>\n            <tr><td style=\"padding:2px 0;color:#666;\">DOJ:</td><td style=\"padding:2px 0;font-weight:bold;\">{{date_of_joining}}</td></tr>\n        </table>\n    </div>\n\n    <!-- Barcode Footer -->\n    <div style=\"position:absolute;bottom:0;left:0;right:0;text-align:center;padding:6px 15px 8px;background:#f5f5f5;border-top:1px solid #e0e0e0;\">\n        <img src=\"{{qr_code_url}}\" style=\"height:22px;width:80%;object-fit:contain;\">\n        <div style=\"font-size:7px;color:#666;letter-spacing:1.5px;margin-top:1px;\">{{staff_no}}</div>\n    </div>\n</div>\n                ",
