  "content": "<div style=\"font-family: 'Courier New', Courier, monospace; width: 300px; margin: 0 auto; color: #000; font-size: 12px; line-height: 1.4; padding: 10px;\">\n    <!-- 80mm Thermal Printer Width (approx 300px) -->\n    \n    <div style=\"text-align: center; margin-bottom: 10px;\">\n        <img src=\"{{school_logo_url}}\" alt=\"Logo\" style=\"max-height: 50px; filter: grayscale(100%); margin-bottom: 5px;\">\n        <div style=\"font-weight: bold; font-size: 14px; text-transform: uppercase;\">{{school_name}}</div>\n        <div style=\"font-size: 10px;\">{{school_address}}</div>\n        <div style=\"font-size: 10px;\">Tel: {{school_phone}}</div>\n    </div>\n    \n    <div style=\"border-top: 1px dashed #000; border-bottom: 1px dashed #000; margin: 10px 0; padding: 5px 0; text-align: center; font-weight: bold; font-size: 14px;\">\n        FEE RECEIPT\n    </div>\n    \n    <div style=\"margin-bottom: 10px;\">\n        RCVD: {{payment_date}}<br>\n        RCPT: {{receipt_no}}<br>\n        MODE: {{payment_mode}} <br>\n        TXN : {{transaction_id}}\n    </div>\n    \n    <div style=\"border-bottom: 1px dashed #000; margin-bottom: 10px; padding-bottom: 5px;\">\n        <strong>STU :</strong> {{student_name}}<br>\n        <strong>ADM :</strong> {{admission_no}}<br>\n        <strong>CLS :</strong> {{class_name}}-{{section_name}}\n    </div>\n    \n    <!-- We don't use the full HTML table here, we just show total because thermal space is tight, or rely on the HTML table fitting if custom styled -->\n    <div style=\"margin-bottom: 15px;\">\n        {{fee_group_breakdown_table}}\n    </div>\n    \n    <div style=\"border-top: 1px dashed #000; padding-top: 10px; margin-bottom: 15px;\">\n        <table style=\"width: 100%; font-weight: bold; font-size: 16px;\">\n            <tr>\n                <td>TOTAL:</td>\n                <td style=\"text-align: right;\">{{currency_symbol}}{{total_paid}}</td>\n            </tr>\n        </table>\n    </div>\n\n    <div style=\"text-align: center; margin-bottom: 15px;\">\n        <img src=\"{{qr_code_url}}\" alt=\"QR\" style=\"width: 80px; height: 80px;\">\n        <div style=\"font-size: 9px; margin-top: 5px;\">Scan for digital copy</div>\n    </div>\n    \n    <div style=\"text-align: center; font-size: 10px;\">\n        System Generated Receipt.<br>\n        Thank you!\n    </div>\n    <div style=\"text-align: center; margin-top: 20px;\">\n        .\n    </div> <!-- Thermal printers need space to cut -->\n</div>\n<style>\n    /* Override table styles inside thermal receipt */\n    table th, table td { font-size: 11px !important; padding: 2px !important; border: none !important; }\n    table thead tr { border-bottom: 1px dashed #000 !important; background: transparent !important; }\n    table tfoot tr { border-top: 1px dashed #000 !important; }\n    h4 { font-size: 12px !important; margin: 5px 0 !important; text-decoration: underline; }\n</style>",
