  "card_width_mm": 210,
  "card_height_mm": 297,
  "content": "<style type=\"text/css\">\n    @page { size: A4 portrait; margin: 8mm; }\n    * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }\n\n    .pw-ms-sheet {\n        width: 194mm; margin: 0 auto; border: 4px solid #0f766e;\n        font-family: 'DejaVu Sans', Arial, Helvetica, sans-serif;\n        color: #1f2937; position: relative; background: #ffffff;\n    }\n    .pw-ms-watermark {\n        position: absolute; top: 46%; left: 50%;\n        margin-left: -45mm; margin-top: -45mm;\n        width: 90mm; height: 90mm; opacity: 0.05; text-align: center;\n    }\n    .pw-ms-watermark img { width: 90mm; height: auto; }\n    .pw-ms-inner { position: relative; padding: 6mm 7mm; }\n\n    .pw-ms-head { width: 100%; border-collapse: collapse; }\n    .pw-ms-head td { vertical-align: middle; }\n    .pw-ms-logo { width: 24mm; text-align: center; }\n    .pw-ms-logo img { width: 22mm; height: 22mm; object-fit: contain; }\n    .pw-ms-title { text-align: center; }\n    .pw-ms-title h1 { margin: 0; font-size: 21pt; font-weight: bold; color: #0f766e; text-transform: uppercase; }\n    .pw-ms-title .addr { margin: 2px 0 0; font-size: 9pt; color: #4b5563; }\n\n    .pw-ms-ribbon {\n        background: #d97706; color: #ffffff; text-align: center;\n        font-size: 12pt; font-weight: bold; letter-spacing: 1px;\n        padding: 5px 0; margin: 6px 0 8px;\n    }\n\n    .pw-ms-info { width: 100%; border-collapse: collapse; font-size: 10.5pt; margin-bottom: 6px; }\n    .pw-ms-info td { padding: 4px 4px; }\n    .pw-ms-info .lbl { font-weight: bold; color: #0f766e; width: 20%; }\n    .pw-ms-info .val { border-bottom: 1px dotted #9ca3af; width: 30%; }\n    .pw-ms-photo { width: 26mm; text-align: right; vertical-align: top; }\n    .pw-ms-photo img { width: 24mm; height: 30mm; object-fit: cover; border: 3px solid #0f766e; }\n\n    .pw-ms-section-title {\n        font-size: 11pt; font-weight: bold; color: #0f766e;\n        border-bottom: 2px solid #d97706; padding-bottom: 2px; margin: 9px 0 5px;\n    }\n\n    .pw-ms-two { width: 100%; border-collapse: collapse; }\n    .pw-ms-two td { width: 50%; vertical-align: top; padding: 0 4px; }\n\n    .pw-ms-note { border: 2px dashed #fcd9a3; background: #fffbeb; padding: 8px 10px; font-size: 10pt; min-height: 16mm; border-radius: 6px; }\n    .pw-ms-note .k { font-weight: bold; color: #d97706; }\n\n    .pw-ms-strip { width: 100%; border-collapse: collapse; margin: 8px 0; font-size: 11pt; }\n    .pw-ms-strip td { border: 2px solid #0f766e; padding: 7px 8px; text-align: center; }\n    .pw-ms-strip .k { font-weight: bold; background: #ccfbf1; }\n\n    .pw-ms-sign { width: 100%; border-collapse: collapse; margin-top: 12mm; font-size: 9.5pt; }\n    .pw-ms-sign td { text-align: center; padding-top: 2px; border-top: 1px solid #374151; width: 33%; }\n\n    .pw-ms-foot { font-size: 8pt; color: #6b7280; text-align: center; margin-top: 6px; }\n</style>\n\n<div class=\"pw-ms-sheet\">\n    <div class=\"pw-ms-watermark\"><img src=\"{{school_logo_url}}\" alt=\"\"></div>\n\n    <div class=\"pw-ms-inner\">\n\n        \n        <table class=\"pw-ms-head\">\n            <tr>\n                <td class=\"pw-ms-logo\"><img src=\"{{school_logo_url}}\" alt=\"Logo\"></td>\n                <td class=\"pw-ms-title\">\n                    <h1>{{school_name}}</h1>\n                    <p class=\"addr\">{{school_address}}</p>\n                </td>\n                <td class=\"pw-ms-logo\">{{qr_code}}</td>\n            </tr>\n        </table>\n\n        <div class=\"pw-ms-ribbon\">My Progress Report  ·  {{academic_session}}</div>\n\n        \n        <table class=\"pw-ms-info\">\n            <tr>\n                <td class=\"lbl\">My Name</td><td class=\"val\">{{student_name}}</td>\n                <td class=\"lbl\">Class</td><td class=\"val\">{{class_section}}</td>\n                <td class=\"pw-ms-photo\" rowspan=\"3\"><img src=\"{{student_photo_url}}\" alt=\"Photo\"></td>\n            </tr>\n            <tr>\n                <td class=\"lbl\">Roll No.</td><td class=\"val\">{{roll_no}}</td>\n                <td class=\"lbl\">Admission No.</td><td class=\"val\">{{admission_no}}</td>\n            </tr>\n            <tr>\n                <td class=\"lbl\">Father</td><td class=\"val\">{{father_name}}</td>\n                <td class=\"lbl\">Attendance</td><td class=\"val\">{{attendance_percentage}}%</td>\n            </tr>\n        </table>\n\n        \n        <div class=\"pw-ms-section-title\">How I Did · Scholastic</div>\n        {{consolidated_marks_table}}\n\n        \n        <table class=\"pw-ms-two\">\n            <tr>\n                <td>\n                    <div class=\"pw-ms-section-title\">My Activities</div>\n                    {{cocurricular_table}}\n                </td>\n                <td>\n                    <div class=\"pw-ms-section-title\">Teacher's Note</div>\n                    <div class=\"pw-ms-note\"><span class=\"k\">Well done!</span> {{teacher_remark}}</div>\n                </td>\n            </tr>\n        </table>\n\n        \n        <table class=\"pw-ms-strip\">\n            <tr>\n                <td class=\"k\">Result</td><td>{{result_status}}</td>\n                <td class=\"k\">Rank</td><td>{{rank}}</td>\n                <td class=\"k\">Date</td><td>{{current_date}}</td>\n            </tr>\n        </table>\n\n        {{grading_scale_inline}}\n\n        \n        <table class=\"pw-ms-sign\">\n            <tr>\n                <td>Class Teacher</td>\n                <td>Principal</td>\n                <td>Parent's Signature</td>\n            </tr>\n        </table>\n\n        <div class=\"pw-ms-foot\">Keep it up! — {{school_name}}.</div>\n    </div>\n</div>",
