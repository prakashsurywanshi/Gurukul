  "content": "<div style=\"width: 320px; height: 480px; border: 1px solid #ddd; font-family: Arial, sans-serif; position: relative; background: #fff;\">\n    <div style=\"text-align: center; padding-top: 20px;\">\n        <img src=\"{{school_logo_url}}\" style=\"height: 50px;\">\n        <h3 style=\"margin: 5px 0; color: #0056b3; font-size: 1.2em;\">{{school_name}}</h3>\n    </div>\n    \n    <div style=\"text-align: center; margin-top: 20px;\">\n        <img src=\"{{student_photo_url}}\" style=\"width: 100px; height: 100px; border-radius: 5px; border: 1px solid #ccc; padding: 2px;\">\n    </div>\n    \n    <div style=\"text-align: center; margin-top: 10px;\">\n        <h2 style=\"margin: 0; color: #333; text-transform: uppercase;\">{{staff_name}}</h2>\n        <p style=\"margin: 5px 0; color: #FF5722; font-weight: bold;\">{{designation}}</p>\n    </div>\n    \n    <div style=\"margin: 20px 30px; font-size: 0.9em;\">\n        <p style=\"margin: 5px 0;\"><strong>ID No:</strong> {{staff_no}}</p>\n        <p style=\"margin: 5px 0;\"><strong>Dept:</strong> {{department}}</p>\n        <p style=\"margin: 5px 0;\"><strong>Phone:</strong> {{phone}}</p>\n        <p style=\"margin: 5px 0;\"><strong>Blood Group:</strong> {{blood_group}}</p>\n    </div>\n    \n    <div style=\"position: absolute; bottom: 20px; width: 100%; text-align: center;\">\n        <img src=\"{{qr_code_url}}\" style=\"height: 40px; width: 80%;\">\n        <p style=\"margin: 0; font-size: 0.7em; letter-spacing: 2px;\">{{staff_no}}</p>\n    </div>\n</div>\n                ",
