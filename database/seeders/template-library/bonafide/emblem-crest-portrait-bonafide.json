  "content": "<div style=\"width: 100%; max-width: 750px; margin: auto; font-family: 'Garamond', serif; background: #fff; border: 1px solid #777; padding: 10px; background-color: #fcfcfc;\"><div style=\"border: 4px double #000; padding: 25px; text-align: center; position: relative;\"><div style=\"position: absolute; top: 35px; left: 35px; font-size: 14px; text-align: left;\"><strong>Serial No:</strong> ..............</div><div style=\"position: absolute; top: 35px; right: 35px; font-size: 14px; text-align: right;\"><strong>Admission No:</strong> {{admission_no}}</div><img src=\"{{school_logo_url}}\" style=\"height: 90px; margin-bottom: 10px;\"><h2 style=\"margin: 0; font-size: 24px; font-weight: bold; letter-spacing: 1px;\">OFFICE OF THE PRINCIPAL</h2><h1 style=\"margin: 5px 0; font-size: 32px; font-weight: bold;\">{{school_name}}</h1><h3 style=\"margin: 25px 0; font-size: 24px; font-weight: normal; text-decoration: underline; text-underline-offset: 4px;\">BONAFIDE CERTIFICATE</h3><div style=\"font-size: 18px; line-height: 2.2; text-align: justify; margin-top: 30px;\"><p style=\"text-indent: 40px;\">This is to certify that Master/Kumari <strong>{{student_name}}</strong> is/was a bonafide student of this school from <span style=\"text-decoration: underline;\">          </span> to <span style=\"text-decoration: underline;\">          </span>. He/She is currently studying in Class <strong>{{class_section}}</strong>.</p><p style=\"text-indent: 40px;\">His/Her date of birth as entered in the school admission register is <strong>{{dob}}</strong>.</p><p style=\"text-indent: 40px;\">To the best of our knowledge, he/she bears a good moral character.</p></div><table style=\"width: 100%; margin-top: 80px; font-size: 16px;\"><tbody><tr><td style=\"text-align: left;\"><strong>Date:</strong> {{current_date}}</td><td style=\"text-align: right;\"><img src=\"{{student_photo_url}}\" style=\"height: 50px;\"><br><strong>Principal</strong></td></tr></tbody></table></div></div>",
